    "private": true,
    "type": "module",
    "homepage": "/omstillingsstonad/soknad",
    "dependencies": {
        "@navikt/aksel-icons": "^8.16.1",
        "@navikt/ds-css": "^8.16.1",
        "@navikt/ds-react": "^8.16.1",
        "@navikt/fnrvalidator": "^2.2.1",
        "@navikt/nav-dekoratoren-moduler": "^4.3.0",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "@vitest/coverage-v8": "^4.1.10",
        "axios": "1.19.0",
        "axios-retry": "^4.5.0",
        "bowser": "^2.14.1",
        "date-fns": "^4.4.0",
        "error-stack-parser": "^2.1.4",
        "i18next": "26.3.6",
        "ibantools": "^4.5.4",
        "lodash": "4.18.1",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-hook-form": "7.85.0",
        "react-i18next": "17.0.11",
        "react-router": "8.3.0",
        "typescript": "^6.0.2",
        "uuid": "14.0.1",
        "vite": "8.2.1",
        "vite-plugin-svgr": "^5.2.0",
        "vitest": "^4.1.10"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.7",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/react-hooks": "^8.0.1",
        "@types/lodash": "^4.17.25",
        "@types/react": "19.2.18",
        "@types/react-dom": "^19.2.4",
        "@types/uuid": "11.0.0",
        "axe-core": "^4.13.0",
        "chai-dom": "^1.12.1",
        "concurrently": "^10.0.4",
        "cypress": "^15.20.0",
        "cypress-axe": "^1.7.0",
        "globals": "^17.9.0",
        "husky": "~9.1.7",
        "jsdom": "^30.0.1"
    },
    "scripts": {
        "dev": "concurrently \"yarn start\" \"yarn start:node\"",
        "start": "vite --base /omstillingsstonad/soknad",
        "start:node": "cd ../etterlatte-node-server && yarn start:oms",
        "build": "tsc && yarn biome lint --no-errors-on-unmatched && vite build --outDir build --base /omstillingsstonad/soknad",
        "test": "vitest",
        "test:coverage": "vitest run --coverage",
        "cy:test": "TZ=Europe/Oslo cypress run",
        "cy:open": "TZ=Europe/Oslo cypress open",
        "eject": "react-scripts eject",
        "lint": "yarn biome check --no-errors-on-unmatched"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "resolutions": {
        "**/braces": "3.0.3",
        "**/ws": "7.5.10"
    },
    "lint-staged": {
        "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
            "biome check --write --no-errors-on-unmatched"
        ]
    }
}
